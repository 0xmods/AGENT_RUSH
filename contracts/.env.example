# AGENT RUSH - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ===========================================
# Private Key for Deployment (TESTNET ONLY!)
# ===========================================
# Get a testnet wallet with tBNB from: https://testnet.bnbchain.org/faucet-smart
# NEVER use a mainnet private key here!
PRIVATE_KEY=your_testnet_private_key_here

# ===========================================
# RPC URLs (Free public endpoints)
# ===========================================
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed1.binance.org/

# ===========================================
# BscScan API Key (Free at https://bscscan.com/apis)
# ===========================================
BSCSCAN_API_KEY=your_bscscan_api_key_here

# ===========================================
# Optional: Gas Reporting
# ===========================================
REPORT_GAS=false
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# ===========================================
# Contract Addresses (Filled after deployment)
# ===========================================
# AGENT_RUSH_CONTRACT_ADDRESS=
# REVENUE_ROUTER_ADDRESS=
# MOCK_AGENT_ID_REGISTRY_ADDRESS=